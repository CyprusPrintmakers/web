# Sanity project ID (required for a Sanity-backed build)
SANITY_PROJECT_ID=
# Sanity dataset name
SANITY_DATASET=production
# Read-only token used for previews and draft content
SANITY_API_READ_TOKEN=
# Enable Sanity visual editing — preview only, never production
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false
# Mark the deployment as staging (adds noindex and a staging badge)
PUBLIC_STAGING=false
# Canonical origin for sitemap and absolute URLs
PUBLIC_SITE_URL=https://cyprus-printmakers-site.vercel.app
# Content source: unset → sanity when SANITY_PROJECT_ID is set, else fixtures; use fixtures for offline work
CONTENT_SOURCE=
# Resend API key for the contact and membership forms
RESEND_API_KEY=
# Sender address; must be on a domain verified in Resend. Defaults to Resend's test sender, which only delivers to the account owner
RESEND_FROM_EMAIL=Cyprus Printmakers <onboarding@resend.dev>
# Contact form recipient
CONTACT_TO_EMAIL=cyprintmakers@gmail.com
# Membership form recipient
MEMBERSHIP_TO_EMAIL=cyprintmakers@gmail.com
# Shared secret used to verify Sanity webhook signatures at /api/sanity-webhook
SANITY_WEBHOOK_SECRET=
# Vercel Deploy Hook called by /api/sanity-webhook after a verified publish
VERCEL_DEPLOY_HOOK_URL=
