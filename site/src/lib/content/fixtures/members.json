            "children": [
              { "_type": "span", "_key": "en-s1", "text": "Maria Georgiou is a Nicosia-based printmaker whose etchings trace the coastline between Paphos and Cape Greco. She studied at the Athens School of Fine Arts and has exhibited in Cyprus, Greece and Italy.", "marks": [] }
            ]
          },
          {
            "_type": "block",
            "_key": "en-b2",
            "style": "normal",
            "markDefs": [],
            "children": [
              { "_type": "span", "_key": "en-s2", "text": "Her plates combine hard ground with collagraph texture, and she teaches etching at the association's studio.", "marks": [] }
            ]
          }
        ]
      },
