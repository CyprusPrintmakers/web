    "body": [
      {
        "_key": "en",
        "language": "en",
        "value": [
          {
            "_type": "block",
            "_key": "en-b1",
            "style": "normal",
            "markDefs": [],
            "children": [
              { "_type": "span", "_key": "en-s1", "text": "Printmaking Days returned to the Old Power Station with a programme that moved between the exhibition hall, the press room and the street. Twenty-two artists showed etchings, lithographs, screen prints and relief work made during the previous year.", "marks": [] }
            ]
          },
          {
            "_type": "block",
            "_key": "en-b2",
            "style": "normal",
            "markDefs": [],
            "children": [
              { "_type": "span", "_key": "en-s2", "text": "The opening weekend included a stone lithography demonstration and a workshop for families, both of which filled every available place.", "marks": [] }
            ]
          }
        ]
      },
      {
        "_key": "el",
        "language": "el",
        "value": [
          {
            "_type": "block",
            "_key": "el-b1",
            "style": "normal",
            "markDefs": [],
            "children": [
              { "_type": "span", "_key": "el-s1", "text": "Οι Ημέρες Χαρακτικής επέστρεψαν στην Παλαιά Ηλεκτρική με ένα πρόγραμμα που κινήθηκε ανάμεσα στην αίθουσα εκθέσεων, το τυπογραφείο και τον δρόμο. Είκοσι δύο καλλιτέχνες παρουσίασαν χαρακτικά, λιθογραφίες, μεταξοτυπίες και ανάγλυφα έργα της χρονιάς.", "marks": [] }
            ]
          },
          {
            "_type": "block",
            "_key": "el-b2",
            "style": "normal",
            "markDefs": [],
            "children": [
              { "_type": "span", "_key": "el-s2", "text": "Το πρώτο σαββατοκύριακο περιλάμβανε επίδειξη λιθογραφίας σε πέτρα και εργαστήρι για οικογένειες, που γέμισαν και τα δύο κάθε διαθέσιμη θέση.", "marks": [] }
