            "markDefs": [],
            "children": [
              { "_type": "span", "_key": "en-s1", "text": "For its tenth year the association opened the archive alongside a new exhibition. Early posters, plates and proof books were shown next to work made in 2017, so visitors could follow a technique from one decade to the next.", "marks": [] }
            ]
          }
        ]
      },
