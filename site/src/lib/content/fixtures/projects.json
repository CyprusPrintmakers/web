    "summary": [
      {
        "_key": "en",
        "language": "en",
        "value": "The first Printmaking Days brought a borrowed press into a Nicosia courtyard and invited the public to print a page of their own."
      },
      {
        "_key": "el",
        "language": "el",
        "value": "Οι πρώτες Ημέρες Χαρακτικής έφεραν ένα δανεικό πιεστήριο σε αυλή της Λευκωσίας και κάλεσαν το κοινό να τυπώσει τη δική του σελίδα."
      }
    ],
    "body": [
      {
        "_key": "en",
        "language": "en",
        "value": [
          {
            "_type": "block",
            "_key": "en-b1",
            "style": "normal",
            "markDefs": [],
            "children": [
              { "_type": "span", "_key": "en-s1", "text": "The first edition was small and improvised: a borrowed press, a trestle table and a courtyard lent by a member's family. Over nine days, visitors printed broadsheets and watched plates being inked and wiped.", "marks": [] }
            ]
          }
        ]
      },
      {
