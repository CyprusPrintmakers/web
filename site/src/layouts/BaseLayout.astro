---
import { ClientRouter, fade } from 'astro:transitions'
import '../styles/tokens.css'
import '../styles/base.css'
import type { Locale } from '../lib/i18n/locales'
import { t } from '../lib/i18n/ui'
import { getContent } from '../lib/content/source'
import { pickLocalized } from '../lib/i18n/localized'
import { organizationJsonLd, pageTitle } from '../lib/seo'
import Footer from '../components/layout/Footer.astro'
import Header from '../components/layout/Header.astro'

interface Props {
  lang: Locale
  title: string
  description: string
  alternates: Record<Locale, string>
  noindex?: boolean
  image?: string
  jsonLd?: object[]
  homeHero?: boolean
}

const {
  lang,
  title,
  description,
  alternates,
  noindex = false,
  image,
  jsonLd = [],
  homeHero = false,
} = Astro.props

const { settings } = await getContent()
const siteName = pickLocalized(settings.siteName, lang).text || 'Cyprus Printmakers Association'
const fullTitle = pageTitle(title, siteName)

const site = Astro.site ?? new URL('https://cyprintmakers.densetheory.cc')
const absolute = (path: string) => new URL(path, site).href
const pathname =
  Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '')
const canonical = absolute(pathname)
const english = absolute(alternates.en)
const greek = absolute(alternates.el)
const staging = import.meta.env.PUBLIC_STAGING === 'true'
const blocked = staging || noindex
const jsonLdBlocks = [organizationJsonLd(settings, lang), ...jsonLd]
---

<!doctype html>
<html lang={lang} transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('cp-theme')
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
          document.documentElement.dataset.theme = theme
        } catch {
          document.documentElement.dataset.theme = 'light'
        }
      })()
    </script>
    <meta name="theme-color" content="#ffffff" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={english} />
    <link rel="alternate" hreflang="el" href={greek} />
    <link rel="alternate" hreflang="x-default" href={english} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta property="og:image" content={absolute(image)} />}
    {blocked && <meta name="robots" content="noindex,nofollow" />}
    {jsonLdBlocks.map(block => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <script is:inline data-astro-rerun>window.__cpDocs = (window.__cpDocs ?? 0) + 1;</script>
    {
      homeHero && (
        <script is:inline>
          (() => {
            try {
              if (window.__cpDocs !== 1) return
              if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
              document.documentElement.dataset.intro = 'pending'
              window.__cpIntroTimeout = setTimeout(() => {
                if (document.documentElement.dataset.intro === 'pending') {
                  delete document.documentElement.dataset.intro
                }
              }, 4000)
            } catch {}
          })()
        </script>
      )
    }
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="page">
      <a class="skip-link" href="#main">{t('a11y.skipToContent', lang)}</a>
      <Header lang={lang} alternates={alternates} showBrand={!homeHero} />
      <main id="main" class:list={['shell', { 'main--home': homeHero }]} tabindex="-1">
        <div class="grid-12">
          <slot />
        </div>
      </main>
      <Footer lang={lang} />
    </div>
    <slot name="overlay" />
    <script is:inline>
      document.addEventListener('astro:after-swap', () => {
        const main = document.querySelector('main#main')
        if (main instanceof HTMLElement) main.focus({ preventScroll: true })
      })
    </script>
  </body>
</html>

<style is:global>
  [data-theme='dark'] .header__mark,
  [data-theme='dark'] .hero-brand__mark,
  [data-theme='dark'] .intro__ghost,
  [data-theme='dark'] .member__mark {
    filter: invert(1);
  }

  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page main {
    flex: 1;
  }

  .page main:not(.main--home) {
    padding-block-start: clamp(24px, 5vw, 56px);
  }

  html[data-intro='pending'] .page,
  html[data-intro='moving'] .page {
    visibility: hidden;
  }

  /* Fail-safe: if reduced motion is requested while the cover is up, the
     hidden .intro must never keep the page hidden. */
  @media (prefers-reduced-motion: reduce) {
    html[data-intro='pending'] .page,
    html[data-intro='moving'] .page {
      visibility: visible;
    }
  }

  .skip-link {
    background: var(--paper);
    border: var(--rule);
    left: -9999px;
    padding: 12px 16px;
    position: absolute;
    top: 0;
    z-index: 10;
  }

  .skip-link:focus {
    left: var(--pad-sm);
    top: var(--pad-sm);
  }
</style>
