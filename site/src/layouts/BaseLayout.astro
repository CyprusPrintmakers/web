---
import { ClientRouter, fade } from 'astro:transitions'
import '../styles/tokens.css'
import '../styles/base.css'
import type { Locale } from '../lib/i18n/locales'
import { t } from '../lib/i18n/ui'
import { getContent } from '../lib/content/source'
import { pickLocalized } from '../lib/i18n/localized'
import { organizationJsonLd, pageTitle } from '../lib/seo'
import Footer from '../components/layout/Footer.astro'
import Header from '../components/layout/Header.astro'

interface Props {
  lang: Locale
  title: string
  description: string
  alternates: Record<Locale, string>
  noindex?: boolean
  image?: string
  jsonLd?: object[]
}

const {
  lang,
  title,
  description,
  alternates,
  noindex = false,
  image,
  jsonLd = [],
} = Astro.props

const { settings } = await getContent()
const siteName = pickLocalized(settings.siteName, lang).text || 'Cyprus Printmakers Association'
const fullTitle = pageTitle(title, siteName)

const site = Astro.site ?? new URL('https://cyprintmakers.densetheory.cc')
const absolute = (path: string) => new URL(path, site).href
const pathname =
  Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '')
const canonical = absolute(pathname)
const english = absolute(alternates.en)
const greek = absolute(alternates.el)
const staging = import.meta.env.PUBLIC_STAGING === 'true'
const blocked = staging || noindex
const jsonLdBlocks = [organizationJsonLd(settings, lang), ...jsonLd]
---

<!doctype html>
<html lang={lang} transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={english} />
    <link rel="alternate" hreflang="el" href={greek} />
    <link rel="alternate" hreflang="x-default" href={english} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta property="og:image" content={absolute(image)} />}
    {blocked && <meta name="robots" content="noindex,nofollow" />}
    {jsonLdBlocks.map(block => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skipToContent', lang)}</a>
    <div class="page">
      <Header lang={lang} alternates={alternates} />
      <main id="main" class="shell" tabindex="-1">
        <div class="grid-12">
          <slot />
        </div>
      </main>
      <Footer lang={lang} />
    </div>
    <script is:inline>
      document.addEventListener('astro:after-swap', () => {
        const main = document.querySelector('main#main')
        if (main instanceof HTMLElement) main.focus({ preventScroll: true })
      })
    </script>
  </body>
</html>

<style is:global>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page main {
    flex: 1;
  }

  .skip-link {
    background: var(--paper);
    border: var(--rule);
    left: -9999px;
    padding: 12px 16px;
    position: absolute;
    top: 0;
    z-index: 10;
  }

  .skip-link:focus {
    left: var(--pad-sm);
    top: var(--pad-sm);
  }
</style>
