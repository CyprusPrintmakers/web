---
import type { Locale } from '../../lib/i18n/locales'
import { brandWordmark } from '../../lib/brand'

interface Props {
  lang: Locale
  href?: string
  label?: string
  class?: string
}

const { lang, href, label, class: className } = Astro.props
const [lead, tail] = brandWordmark(lang)
---

{
  href ? (
    <a class:list={['brand', className]} href={href} aria-label={label}>
      <img
        class="brand__mark"
        src="/mark.png"
        alt=""
        width="158"
        height="192"
        decoding="async"
      />
      <span class="brand__wordmark">
        <span data-brand-line>{lead}</span>
        <span data-brand-line>{tail}</span>
      </span>
    </a>
  ) : (
    <span class:list={['brand', className]} aria-hidden="true">
      <img
        class="brand__mark"
        src="/mark.png"
        alt=""
        width="158"
        height="192"
        decoding="async"
      />
      <span class="brand__wordmark">
        <span data-brand-line>{lead}</span>
        <span data-brand-line>{tail}</span>
      </span>
    </span>
  )
}

<style>
  .brand {
    align-items: flex-end;
    color: inherit;
    display: inline-flex;
    gap: clamp(12px, 1.6vw, 24px);
    text-decoration: none;
  }

  .brand:hover .brand__wordmark {
    text-decoration: underline;
  }

  .brand__mark {
    aspect-ratio: 158 / 192;
    flex-shrink: 0;
    height: auto;
    object-fit: cover;
    width: clamp(64px, 12vw, 158px);
  }

  .brand__wordmark {
    display: flex;
    flex-direction: column;
    font-size: 24px;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }

  @media (min-width: 600px) {
    .brand__wordmark {
      font-size: 32px;
    }
  }
</style>