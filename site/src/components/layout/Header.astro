---
import type { Locale } from '../../lib/i18n/locales'
import { localePath } from '../../lib/i18n/locales'
import { t, type UIKey } from '../../lib/i18n/ui'
import { brandWordmark } from '../../lib/brand'
import LanguageSwitcher from './LanguageSwitcher.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  lang: Locale
  alternates: Record<Locale, string>
  showBrand?: boolean
  homeHero?: boolean
}

const { lang, alternates, showBrand = true, homeHero = false } = Astro.props

const items: Array<{ key: UIKey; path: string }> = [
  { key: 'nav.members', path: '/members' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.news', path: '/news' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.contact', path: '/contact' },
]

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '')
const wordmark = brandWordmark(lang)
const menuLabel = t('nav.menu', lang)
---

<header class="header shell">
  {
    homeHero ? (
      <div class="header__top header__top--home">
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="home-menu"
          data-menu-toggle
        >
          <span class="menu-toggle__lines" aria-hidden="true">
            <span />
            <span />
            <span />
          </span>
          <span class="sr-only">{menuLabel}</span>
        </button>

        <div class="header__menu" id="home-menu" data-menu-panel hidden>
          <nav class="header__menu-nav" aria-label={menuLabel}>
            <ul class="nav__list nav__list--panel">
              {items.map(item => {
                const href = localePath(item.path, lang)
                const active = currentPath === href
                return (
                  <li class="nav__item">
                    <a
                      class={`nav__link${active ? ' nav__link--active' : ''}`}
                      href={href}
                      aria-current={active ? 'page' : undefined}
                    >
                      {t(item.key, lang)}
                    </a>
                  </li>
                )
              })}
            </ul>
          </nav>
          <div class="header__menu-actions">
            <LanguageSwitcher lang={lang} alternates={alternates} />
            <ThemeToggle lang={lang} />
          </div>
        </div>
      </div>
    ) : (
      <div class:list={['header__top', { 'header__top--nobrand': !showBrand }]}>
        {showBrand && (
          <a
            class="header__brand"
            href={localePath('/', lang)}
            aria-label={`ΚΥΠΡΙΟΙ ΧΑΡΑΚΤΕΣ — ${wordmark.join(' ')}`}
          >
            <img
              class="header__mark"
              src="/mark.png"
              alt=""
              width="158"
              height="152"
              decoding="async"
            />
            <span class="header__caption" lang="el">ΚΥΠΡΙΟΙ ΧΑΡΑΚΤΕΣ</span>
          </a>
        )}

        <nav class="nav">
          <ul class="nav__list">
            {items.map(item => {
              const href = localePath(item.path, lang)
              const active = currentPath === href
              return (
                <li class="nav__item">
                  <a
                    class={`nav__link${active ? ' nav__link--active' : ''}`}
                    href={href}
                    aria-current={active ? 'page' : undefined}
                  >
                    {t(item.key, lang)}
                  </a>
                </li>
              )
            })}
            <li class="nav__item nav__item--lang">
              <LanguageSwitcher lang={lang} alternates={alternates} />
            </li>
          </ul>
        </nav>

        <div class="header__actions">
          <ThemeToggle lang={lang} />
        </div>
      </div>
    )
  }
</header>

<script is:inline src="/scripts/header-menu.js" defer></script>

<style>
  .header {
    padding-block-start: var(--pad-sm);
    position: relative;
  }

  .header__top {
    align-items: start;
    display: grid;
    gap: 12px 32px;
    grid-template-areas: 'brand nav actions';
    grid-template-columns: auto 1fr auto;
  }

  .header__top--nobrand {
    grid-template-areas: 'nav actions';
    grid-template-columns: 1fr auto;
  }

  .header__top--home {
    align-items: center;
    display: flex;
    justify-content: flex-end;
    position: relative;
  }

  .header__brand {
    align-items: center;
    color: inherit;
    display: grid;
    gap: 4px;
    grid-area: brand;
    justify-items: center;
    text-decoration: none;
    width: clamp(48px, 7vw, 64px);
  }

  .header__brand:hover .header__caption {
    color: var(--ink);
  }

  .header__mark {
    height: auto;
    width: 100%;
  }

  .header__caption {
    color: var(--muted-text);
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-align: center;
  }

  .header__actions {
    align-items: center;
    display: flex;
    gap: 12px;
    grid-area: actions;
  }

  .nav {
    grid-area: nav;
    justify-self: end;
    min-width: 0;
  }

  .nav__list {
    align-items: center;
    column-gap: clamp(12px, 3.3vw, 50px);
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    row-gap: 6px;
  }

  .nav__item--lang {
    align-items: center;
    display: inline-flex;
  }

  .nav__link {
    font-size: var(--text-note);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__link:hover,
  .nav__link--active {
    text-decoration: underline;
  }

  .menu-toggle {
    align-items: center;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    height: 44px;
    justify-content: center;
    padding: 0;
    width: 44px;
  }

  .menu-toggle__lines {
    display: grid;
    gap: 5px;
    width: 22px;
  }

  .menu-toggle__lines span {
    background: currentColor;
    display: block;
    height: 1.5px;
    width: 100%;
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .header__menu {
    background: var(--paper);
    border: var(--rule);
    min-width: 280px;
    padding: 20px;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 30;
  }

  .header__menu[hidden] {
    display: none;
  }

  .nav__list--panel {
    align-items: start;
    display: grid;
    gap: 10px;
  }

  .nav__list--panel .nav__link {
    font-size: var(--text-body);
  }

  .header__menu-actions {
    align-items: center;
    border-top: var(--rule);
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 14px;
  }

  @media (max-width: 899px) {
    .header__top {
      grid-template-areas:
        'brand . actions'
        'nav nav nav';
      grid-template-columns: auto 1fr auto;
    }

    .header__top--nobrand {
      grid-template-areas:
        'actions'
        'nav';
      grid-template-columns: 1fr;
    }

    .header__top--nobrand .header__actions {
      justify-self: end;
    }

    .nav {
      justify-self: start;
    }

    .header__menu {
      left: 0;
      min-width: 0;
      right: 0;
    }
  }

  @media (min-width: 900px) {
    .header {
      padding-block-start: var(--pad);
    }
  }
</style>
