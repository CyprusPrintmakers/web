---
import type { Locale } from '../../lib/i18n/locales'
import { localePath } from '../../lib/i18n/locales'
import { t, type UIKey } from '../../lib/i18n/ui'
import { brandWordmark } from '../../lib/brand'
import Brand from './Brand.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props {
  lang: Locale
  alternates: Record<Locale, string>
  showBrand?: boolean
}

const { lang, alternates, showBrand = true } = Astro.props

const items: Array<{ key: UIKey; path: string }> = [
  { key: 'nav.members', path: '/members' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.support', path: '/support' },
  { key: 'nav.news', path: '/news' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.contact', path: '/contact' },
]

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '')
const wordmark = brandWordmark(lang)
---

<header class="header shell">
  <div class="header__top">
    <nav class="nav">
      <ul class="nav__list">
        {
          items.map(item => {
            const href = localePath(item.path, lang)
            const active = currentPath === href
            return (
              <li class="nav__item">
                <a
                  class={`nav__link${active ? ' nav__link--active' : ''}`}
                  href={href}
                  aria-current={active ? 'page' : undefined}
                >
                  {t(item.key, lang)}
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
    <LanguageSwitcher lang={lang} alternates={alternates} />
  </div>

  {
    showBrand && (
      <div class="header__brand">
        <Brand lang={lang} href={localePath('/', lang)} label={wordmark.join(' ')} />
      </div>
    )
  }
</header>

<style>
  .header {
    padding-block-start: var(--pad-sm);
  }

  .header__top {
    align-items: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
  }

  .nav {
    min-width: 0;
  }

  .nav__list {
    column-gap: clamp(16px, 3.3vw, 50px);
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    row-gap: 8px;
  }

  .nav__link {
    font-size: 24px;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__link:hover,
  .nav__link--active {
    text-decoration: underline;
  }

  .header__brand {
    margin-top: clamp(48px, 9vw, 139px);
  }

  @media (min-width: 900px) {
    .header {
      padding-block-start: var(--pad);
    }

    .nav__link {
      font-size: 32px;
    }
  }
</style>
