---
import type { Locale } from '../../lib/i18n/locales'
import { localePath } from '../../lib/i18n/locales'
import { t, type UIKey } from '../../lib/i18n/ui'
import { brandWordmark } from '../../lib/brand'
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props {
  lang: Locale
  alternates: Record<Locale, string>
  showBrand?: boolean
}

const { lang, alternates, showBrand = true } = Astro.props

const items: Array<{ key: UIKey; path: string }> = [
  { key: 'nav.members', path: '/members' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.support', path: '/support' },
  { key: 'nav.news', path: '/news' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.contact', path: '/contact' },
]

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '')
const wordmark = brandWordmark(lang)
---

<header class="header shell">
  <div class:list={['header__top', { 'header__top--nobrand': !showBrand }]}>
    {
      showBrand && (
        <a
          class="header__brand"
          href={localePath('/', lang)}
          aria-label={`ΚΥΠΡΙΟΙ ΧΑΡΑΚΤΕΣ — ${wordmark.join(' ')}`}
        >
          <img
            class="header__mark"
            src="/mark.png"
            alt=""
            width="158"
            height="192"
            decoding="async"
          />
          <span class="header__caption" lang="el">ΚΥΠΡΙΟΙ ΧΑΡΑΚΤΕΣ</span>
        </a>
      )
    }

    <nav class="nav">
      <ul class="nav__list">
        {
          items.map(item => {
            const href = localePath(item.path, lang)
            const active = currentPath === href
            return (
              <li class="nav__item">
                <a
                  class={`nav__link${active ? ' nav__link--active' : ''}`}
                  href={href}
                  aria-current={active ? 'page' : undefined}
                >
                  {t(item.key, lang)}
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>

    <LanguageSwitcher lang={lang} alternates={alternates} />
  </div>
</header>

<style>
  .header {
    padding-block-start: var(--pad-sm);
  }

  .header__top {
    align-items: start;
    display: grid;
    gap: 12px 32px;
    grid-template-areas: 'brand nav lang';
    grid-template-columns: auto 1fr auto;
  }

  .header__top--nobrand {
    grid-template-areas: 'nav lang';
    grid-template-columns: 1fr auto;
  }

  .header__brand {
    align-items: center;
    color: inherit;
    display: grid;
    gap: 4px;
    grid-area: brand;
    justify-items: center;
    text-decoration: none;
    width: clamp(48px, 7vw, 64px);
  }

  .header__brand:hover .header__caption {
    color: var(--ink);
  }

  .header__mark {
    height: auto;
    width: 100%;
  }

  .header__caption {
    color: var(--muted-text);
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-align: center;
  }

  .nav {
    grid-area: nav;
    justify-self: end;
    min-width: 0;
  }

  .nav__list {
    column-gap: clamp(16px, 3.3vw, 50px);
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    row-gap: 8px;
  }

  .nav__link {
    font-size: var(--text-note);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__link:hover,
  .nav__link--active {
    text-decoration: underline;
  }

  @media (max-width: 899px) {
    .header__top {
      grid-template-areas:
        'brand . lang'
        'nav nav nav';
      grid-template-columns: auto 1fr auto;
    }

    .header__top--nobrand {
      grid-template-areas: 'nav lang';
      grid-template-columns: 1fr auto;
    }

    .nav {
      justify-self: start;
    }
  }

  @media (min-width: 900px) {
    .header {
      padding-block-start: var(--pad);
    }
  }
</style>
