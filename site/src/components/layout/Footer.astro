---
import type { Locale } from '../../lib/i18n/locales'
import { localePath } from '../../lib/i18n/locales'
import { t } from '../../lib/i18n/ui'
import StagingBadge from './StagingBadge.astro'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const name =
  lang === 'en' ? 'Cyprus Printmakers Association' : 'Σύλλογος Χαρακτών Κύπρου'
const year = new Date().getFullYear()
---

<footer class="footer shell">
  <div class="footer__inner">
    <p class="footer__line">{name} — {year}</p>
    <div class="footer__links">
      <a class="footer__privacy" href={localePath('/privacy', lang)}>{t('footer.privacy', lang)}</a>
      <StagingBadge lang={lang} />
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--rule);
    margin-top: clamp(64px, 10vw, 160px);
    padding-block: 24px;
  }

  .footer__inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
  }

  .footer__line {
    color: var(--graphite);
    font-size: var(--text-note);
    line-height: 1.4;
  }

  .footer__links {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer__privacy {
    font-size: var(--text-small);
    text-underline-offset: 0.15em;
  }
</style>
