---
import type { Locale } from '../../lib/i18n/locales'
import StagingBadge from './StagingBadge.astro'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const name =
  lang === 'en' ? 'Cyprus Printmakers Association' : 'Σύλλογος Χαρακτών Κύπρου'
const year = new Date().getFullYear()
---

<footer class="footer shell">
  <div class="footer__inner">
    <p class="footer__line">{name} — {year}</p>
    <StagingBadge lang={lang} />
  </div>
</footer>

<style>
  .footer {
    border-top: var(--rule);
    margin-top: clamp(64px, 10vw, 160px);
    padding-block: 24px;
  }

  .footer__inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
  }

  .footer__line {
    color: var(--graphite);
    font-size: 24px;
    line-height: 1.4;
  }
</style>
