---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Figure from '../ui/Figure.astro'
import LocalizedText from '../ui/LocalizedText.astro'
import Prose from '../ui/Prose.astro'
import Rule from '../ui/Rule.astro'
import { imageAttrs } from '../../lib/media'
import type { Project } from '../../lib/content/types'
import { formatDate } from '../../lib/i18n/format'
import type { Locale } from '../../lib/i18n/locales'
import { pickLocalized, pickRich } from '../../lib/i18n/localized'
import { isFullyTranslated } from '../../lib/content/translation'
import { visualArtworkJsonLd } from '../../lib/seo'
import { t } from '../../lib/i18n/ui'

interface Props {
  lang: Locale
  project: Project
}

const { lang, project } = Astro.props

const noindex = lang === 'el' && !isFullyTranslated(project, 'project', 'el')
const jsonLd = [visualArtworkJsonLd(project, lang)]

// No image URL builder exists yet, so gallery images resolve to the 1 px rule
// placeholder with reserved dimensions (same as the home cover).
const urlFor = () => ''
const cover = imageAttrs(project.coverImage, { urlFor })
const gallery = project.gallery.map(image => imageAttrs(image, { urlFor }))
const body = pickRich(project.body, lang)

const title = pickLocalized(project.title, lang)
const summary = pickLocalized(project.summary, lang)
const venue = pickLocalized(project.venue, lang)

const start = project.dates.start ? formatDate(project.dates.start, lang) : ''
const end = project.dates.end ? formatDate(project.dates.end, lang) : ''
const dates =
  start !== '' && end !== '' && start !== end ? `${start} – ${end}` : start === '' ? end : start
---

<BaseLayout
  lang={lang}
  noindex={noindex}
  jsonLd={jsonLd}
  title={title.text}
  description={summary.text}
  alternates={{ en: `/projects/${project.slug}`, el: `/el/projects/${project.slug}` }}
>
  <article class="project">
    <p class="project__meta t-small">
      <span>{project.year}</span>
      {venue.text !== '' && <span>{venue.text}</span>}
      {dates !== '' && <span>{dates}</span>}
    </p>

    <h1 class="project__title t-display">
      <LocalizedText value={project.title} lang={lang} />
    </h1>

    {
      summary.text !== '' && (
        <p class="project__summary t-title" lang={summary.isFallback ? 'en' : lang}>
          {summary.text}
        </p>
      )
    }

    {
      cover.src !== undefined && (
        <Figure
          src={cover.src}
          alt={cover.alt}
          width={cover.width}
          height={cover.height}
          lang={lang}
        />
      )
    }

    <div class="project__body">
      <Prose value={body} lang={lang} />
    </div>

    {
      gallery.length > 0 && (
        <section class="project__gallery" aria-labelledby="gallery-heading" data-gallery>
          <h2 id="gallery-heading" class="t-title">{t('projects.gallery', lang)}</h2>
          <div class="project__gallery-grid">
            {gallery.map(image => (
              <div data-gallery-item>
                <Figure
                  src={image.src}
                  alt={image.alt}
                  width={image.width}
                  height={image.height}
                  lang={lang}
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <Rule />

    {
      project.participants.length > 0 && (
        <section class="project__section" aria-labelledby="participants-heading">
          <h2 id="participants-heading" class="t-small project__label">
            {t('projects.participants', lang)}
          </h2>
          <ul class="project__participants">
            {project.participants.map(participant => (
              <li class="t-body">{participant}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      project.links.length > 0 && (
        <section class="project__section" aria-labelledby="links-heading">
          <h2 id="links-heading" class="t-small project__label">
            {t('projects.links', lang)}
          </h2>
          <ul class="project__links">
            {project.links.map(link => (
              <li class="t-body">
                <a href={link.href} rel="noopener">{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .project {
    display: flex;
    flex-direction: column;
  }

  .project__meta {
    color: var(--muted-text);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0 0 16px;
  }

  .project__title {
    margin-bottom: clamp(16px, 2vw, 32px);
  }

  .project__summary {
    margin: 0 0 clamp(32px, 5vw, 64px);
    max-width: 40em;
  }

  .project__body {
    margin-bottom: clamp(48px, 6vw, 96px);
    max-width: 40em;
  }

  .project__gallery {
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .project__gallery h2 {
    margin-bottom: clamp(16px, 2vw, 32px);
  }

  .project__gallery-grid {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project__section {
    margin-bottom: clamp(32px, 5vw, 64px);
  }

  .project__label {
    color: var(--muted-text);
    margin: 0 0 8px;
  }

  .project__participants,
  .project__links {
    display: grid;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project__links a {
    text-decoration: none;
  }

  .project__links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 767.98px) {
    .project__gallery-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
