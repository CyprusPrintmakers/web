---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LocalizedText from '../ui/LocalizedText.astro'
import TierList from './TierList.astro'
import { getContent } from '../../lib/content/source'
import type { Locale } from '../../lib/i18n/locales'
import { pickLocalized } from '../../lib/i18n/localized'
import { t } from '../../lib/i18n/ui'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const { support } = await getContent()
const intro = pickLocalized(support.intro, lang)
const notes = pickLocalized(support.notes, lang)
---

<BaseLayout
  lang={lang}
  title={t('membership.support', lang)}
  description={intro.text}
  alternates={{ en: '/support', el: '/el/support' }}
>
  <article class="support">
    <h1 class="support__heading t-display">{t('membership.support', lang)}</h1>

    {
      intro.text !== '' && (
        <p class="support__intro t-body">
          <LocalizedText value={support.intro} lang={lang} />
        </p>
      )
    }

    <TierList tiers={support.tiers} confirmed={support.tiersConfirmed} lang={lang} />

    {
      notes.text !== '' && (
        <p class="support__notes t-body">
          <LocalizedText value={support.notes} lang={lang} />
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  .support {
    display: flex;
    flex-direction: column;
  }

  .support__heading {
    margin-bottom: clamp(16px, 2vw, 32px);
  }

  .support__intro {
    margin: 0 0 clamp(32px, 5vw, 64px);
    max-width: 40em;
  }

  .support__notes {
    margin-top: clamp(48px, 6vw, 96px);
    max-width: 40em;
  }
</style>
