---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LocalizedText from '../ui/LocalizedText.astro'
import { getContent } from '../../lib/content/source'
import { paginate } from '../../lib/news/paginate'
import { localePath, type Locale } from '../../lib/i18n/locales'
import { pickLocalized } from '../../lib/i18n/localized'
import { formatDate } from '../../lib/i18n/format'
import { t } from '../../lib/i18n/ui'
import { isFullyTranslated } from '../../lib/content/translation'

interface Props {
  lang: Locale
  page?: number
}

const { lang, page = 1 } = Astro.props
const { news } = await getContent()

const noindex = lang === 'el' && news.some(item => !isFullyTranslated(item, 'newsPost', 'el'))
const newestFirst = [...news].sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
)
const { items, pages } = paginate(newestFirst, page, 10)
---

<BaseLayout
  lang={lang}
  noindex={noindex}
  title={t('news.heading', lang)}
  description={t('news.heading', lang)}
  alternates={{ en: '/news', el: '/el/news' }}
>
  <article class="news">
    <h1 class="news__heading t-display">{t('news.heading', lang)}</h1>

    <ul class="news__list">
      {
        items.map(post => {
          const excerpt = pickLocalized(post.excerpt, lang)
          const date = formatDate(post.publishedAt, lang)
          const href = localePath(`/news/${post.slug}`, lang)

          return (
            <li class="news__item" data-post>
              <a class="news__title t-title" href={href}>
                <LocalizedText value={post.title} lang={lang} />
              </a>
              {date !== '' && (
                <time class="news__date t-small" datetime={post.publishedAt}>
                  {date}
                </time>
              )}
              {excerpt.text !== '' && (
                <p class="news__excerpt t-body" lang={excerpt.isFallback ? 'en' : lang}>
                  {excerpt.text}
                </p>
              )}
            </li>
          )
        })
      }
    </ul>

    {
      pages > 1 && (
        <nav class="news__pagination" aria-label={t('news.heading', lang)}>
          {page > 1 && (
            <a class="t-body" href={page === 2 ? localePath('/news', lang) : localePath(`/news/page/${page - 1}`, lang)}>
              ←
            </a>
          )}
          <span class="t-small">
            {page} / {pages}
          </span>
          {page < pages && (
            <a class="t-body" href={localePath(`/news/page/${page + 1}`, lang)}>
              →
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .news {
    display: flex;
    flex-direction: column;
  }

  .news__heading {
    margin-bottom: clamp(32px, 5vw, 64px);
  }

  .news__list {
    border-top: var(--rule);
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .news__item {
    border-bottom: var(--rule);
    display: grid;
    gap: 8px;
    padding: 24px 0;
  }

  .news__title {
    text-decoration: none;
  }

  .news__title:hover {
    text-decoration: underline;
  }

  .news__date {
    color: var(--muted-text);
  }

  .news__excerpt {
    margin: 0;
    max-width: 40em;
  }

  .news__pagination {
    align-items: center;
    display: flex;
    gap: 16px;
    justify-content: center;
    margin: clamp(24px, 4vw, 48px) 0;
  }

  .news__pagination a {
    text-decoration: none;
  }
</style>
