---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LocalizedText from '../ui/LocalizedText.astro'
import MemberFilter from '../filters/MemberFilter.astro'
import { getContent } from '../../lib/content/source'
import { groupByLetter, sortByFirstName } from '../../lib/members/filter'
import { localePath, type Locale } from '../../lib/i18n/locales'
import { pickLocalized } from '../../lib/i18n/localized'
import { t } from '../../lib/i18n/ui'
import { isFullyTranslated } from '../../lib/content/translation'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const { members, committee } = await getContent()

const noindex = lang === 'el' && members.some(item => !isFullyTranslated(item, 'member', 'el'))
const sorted = sortByFirstName(members, lang)
const featured = sorted.filter(member => member.featured)
const letters = [...groupByLetter(sorted, lang).keys()]
---

<BaseLayout
  lang={lang}
  noindex={noindex}
  title={t('members.heading', lang)}
  description={t('members.directory', lang)}
  alternates={{ en: '/members', el: '/el/members' }}
>
  <article class="members">
    <h1 class="sr-only">{t('members.heading', lang)}</h1>

    <a class="members__become t-body" href={localePath('/membership', lang)}>
      {t('membership.back', lang)} <span aria-hidden="true">→</span>
    </a>

    {
      featured.length > 0 && (
        <section class="members__featured" aria-labelledby="featured-heading">
          <h2 id="featured-heading" class="members__label t-label">
            {t('members.featured', lang)}
          </h2>
          <ul class="members__featured-list">
            {featured.map(person => {
              const name = pickLocalized(person.name, lang).text
              const website = person.website?.trim()

              return (
                <li>
                  {website ? (
                    <a
                      href={website}
                      rel="noopener"
                      aria-label={`${name} — ${t('members.website', lang)}`}
                    >
                      <span class="members__featured-name">
                        <LocalizedText value={person.name} lang={lang} />
                      </span>
                      <svg
                        class="members__arrow"
                        viewBox="0 0 12 12"
                        width="13"
                        height="13"
                        aria-hidden="true"
                      >
                        <path
                          d="M3 9L9 3M9 3H4M9 3V8"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                      </svg>
                    </a>
                  ) : (
                    <span>
                      <span class="members__featured-name">
                        <LocalizedText value={person.name} lang={lang} />
                      </span>
                    </span>
                  )}
                </li>
              )
            })}
          </ul>
        </section>
      )
    }

    <section class="members__committee" aria-labelledby="committee-heading" data-committee>
      <h2 id="committee-heading" class="members__label t-label">
        {t('members.committeeLong', lang)}
      </h2>
      <ul class="members__committee-list">
        {
          committee.map(person => (
            <li class="members__committee-member">
              <span class="members__committee-name t-body">
                <LocalizedText value={person.name} lang={lang} />
              </span>
              <span class="members__role t-note">
                <LocalizedText value={person.role} lang={lang} />
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="members__directory" aria-labelledby="directory-heading">
      <h2 id="directory-heading" class="members__directory-title t-title">
        {t('members.directory', lang)}
      </h2>

      <MemberFilter lang={lang} letters={letters} total={members.length} />

      <ol class="members__list">
        {
          sorted.map((member, index) => {
            const name = pickLocalized(member.name, lang).text
            const letter = name.trim().charAt(0).toLocaleUpperCase(lang)
            const website = member.website?.trim()

            return (
              <li class="members__item" data-member data-letter={letter}>
                <span class="members__number" aria-hidden="true">
                  {index + 1}
                </span>
                <span class="members__name">
                  <LocalizedText value={member.name} lang={lang} />
                  {website && (
                    <a
                      class="members__website"
                      href={website}
                      rel="noopener"
                      aria-label={`${name} — ${t('members.website', lang)}`}
                    >
                      <svg
                        class="members__arrow"
                        viewBox="0 0 12 12"
                        width="13"
                        height="13"
                        aria-hidden="true"
                      >
                        <path
                          d="M3 9L9 3M9 3H4M9 3V8"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                      </svg>
                    </a>
                  )}
                </span>
              </li>
            )
          })
        }
      </ol>
    </section>
  </article>
</BaseLayout>

<script is:inline src="/scripts/members-filter.js" defer></script>

<style>
  .members {
    display: flex;
    flex-direction: column;
  }

  .members__become {
    align-self: flex-start;
    font-weight: var(--fw-medium);
    margin-bottom: clamp(48px, 8vw, 96px);
    margin-top: clamp(24px, 5vw, 56px);
    text-decoration: none;
  }

  .members__become:hover {
    text-decoration: underline;
  }

  .members__featured {
    margin-bottom: clamp(48px, 7vw, 96px);
  }

  .members__featured-list {
    display: grid;
    gap: 0 32px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .members__featured-list li {
    border-top: var(--rule);
  }

  .members__featured-list a,
  .members__featured-list li > span {
    align-items: baseline;
    display: flex;
    gap: 8px;
    padding: 10px 0;
    text-decoration: none;
  }

  .members__featured-list a:hover .members__featured-name {
    text-decoration: underline;
  }

  .members__featured-name {
    font-size: var(--text-body);
    line-height: 1.3;
  }

  .members__committee {
    margin-bottom: clamp(48px, 7vw, 96px);
  }

  .members__label {
    color: var(--muted-text);
    font-size: var(--text-note);
    letter-spacing: 0;
    margin: 0 0 clamp(16px, 2vw, 24px);
    text-transform: none;
  }

  .members__committee-list {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .members__committee-member {
    align-items: start;
    display: grid;
    gap: 2px;
    justify-items: start;
  }

  .members__committee-name {
    text-decoration: none;
  }

  .members__role {
    color: var(--muted-text);
  }

  .members__directory {
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .members__directory-title {
    margin: 0 0 clamp(24px, 4vw, 40px);
  }

  .members__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .members__item {
    align-items: baseline;
    column-gap: 24px;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    min-height: 44px;
    padding: 10px 0;
  }

  .members__item[hidden] {
    display: none;
  }

  .members__number {
    color: var(--muted-text);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }

  .members__name {
    font-size: var(--text-body);
    line-height: 1.3;
  }

  .members__website {
    color: inherit;
    display: inline-flex;
    margin-left: 8px;
    text-decoration: none;
    vertical-align: -1px;
  }

  .members__arrow {
    transition: transform var(--motion-fast) var(--ease-out-expo);
  }

  .members__website:hover .members__arrow,
  .members__featured-list a:hover .members__arrow {
    transform: translate(2px, -2px);
  }
</style>
