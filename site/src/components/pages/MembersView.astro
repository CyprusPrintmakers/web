---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LocalizedText from '../ui/LocalizedText.astro'
import Prose from '../ui/Prose.astro'
import MemberFilter from '../filters/MemberFilter.astro'
import { getContent } from '../../lib/content/source'
import { groupByLetter, sortByFirstName } from '../../lib/members/filter'
import { localePath, type Locale } from '../../lib/i18n/locales'
import { pickLocalized, pickRich } from '../../lib/i18n/localized'
import { t } from '../../lib/i18n/ui'
import { isFullyTranslated } from '../../lib/content/translation'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const { members, committee } = await getContent()

const noindex = lang === 'el' && members.some(item => !isFullyTranslated(item, 'member', 'el'))
const sorted = sortByFirstName(members, lang)
const letters = [...groupByLetter(sorted, lang).keys()]
---

<BaseLayout
  lang={lang}
  noindex={noindex}
  title={t('members.heading', lang)}
  description={t('members.directory', lang)}
  alternates={{ en: '/members', el: '/el/members' }}
>
  <article class="members">
    <h1 class="sr-only">{t('members.heading', lang)}</h1>

    <a class="members__become t-body" href={localePath('/membership', lang)}>
      {t('membership.back', lang)} <span aria-hidden="true">→</span>
    </a>

    <section class="members__committee" aria-labelledby="committee-heading" data-committee>
      <h2 id="committee-heading" class="members__label t-label">
        {t('members.committeeLong', lang)}
      </h2>
      <ul class="members__committee-list">
        {
          committee.map(person => {
            const href = person.memberRef
              ? localePath(`/members/${person.memberRef}`, lang)
              : undefined

            return (
              <li class="members__committee-member">
                {href ? (
                  <a class="members__committee-name t-body" href={href}>
                    <LocalizedText value={person.name} lang={lang} />
                  </a>
                ) : (
                  <span class="members__committee-name t-body">
                    <LocalizedText value={person.name} lang={lang} />
                  </span>
                )}
                <span class="members__role t-note">
                  <LocalizedText value={person.role} lang={lang} />
                </span>
              </li>
            )
          })
        }
      </ul>
    </section>

    <section class="members__directory" aria-labelledby="directory-heading">
      <h2 id="directory-heading" class="members__directory-title t-title">
        {t('members.directory', lang)}
      </h2>

      <MemberFilter lang={lang} letters={letters} total={members.length} />

      <ol class="members__list">
        {
          sorted.map((member, index) => {
            const name = pickLocalized(member.name, lang).text
            const letter = name.trim().charAt(0).toLocaleUpperCase(lang)
            const bio = pickRich(member.bio, lang)
            const email = member.email?.trim()
            const slug = member.slug

            return (
              <li class="members__item" data-member data-letter={letter}>
                <details class="members__entry" id={`member-${slug}`} name="member">
                  <summary class="members__row">
                    <span class="members__number" aria-hidden="true">
                      {index + 1}
                    </span>
                    <span class="members__name">
                      <LocalizedText value={member.name} lang={lang} />
                    </span>
                    {email && <span class="members__email">{email}</span>}
                  </summary>
                  <div class="members__bio">
                    <Prose value={bio} lang={lang} />
                    <p class="members__links t-small">
                      <a href={localePath(`/members/${slug}`, lang)}>
                        {t('members.profile', lang)} <span aria-hidden="true">→</span>
                      </a>
                      {email && (
                        <a href={`mailto:${email}`}>
                          {t('members.email', lang)} <span aria-hidden="true">→</span>
                        </a>
                      )}
                    </p>
                  </div>
                </details>
              </li>
            )
          })
        }
      </ol>
    </section>
  </article>
</BaseLayout>

<script is:inline src="/scripts/members-filter.js" defer></script>
<script is:inline src="/scripts/members-bio.js" defer></script>

<style>
  .members {
    display: flex;
    flex-direction: column;
  }

  .members__become {
    align-self: flex-start;
    font-weight: var(--fw-medium);
    margin-bottom: clamp(48px, 8vw, 96px);
    margin-top: clamp(24px, 5vw, 56px);
    text-decoration: none;
  }

  .members__become:hover {
    text-decoration: underline;
  }

  .members__committee {
    margin-bottom: clamp(48px, 7vw, 96px);
  }

  .members__label {
    color: var(--muted-text);
    font-size: var(--text-note);
    letter-spacing: 0;
    margin: 0 0 clamp(16px, 2vw, 24px);
    text-transform: none;
  }

  .members__committee-list {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .members__committee-member {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    justify-content: space-between;
  }

  .members__committee-name {
    text-decoration: none;
  }

  .members__committee-name:hover {
    text-decoration: underline;
  }

  .members__role {
    color: var(--muted-text);
  }

  .members__directory {
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .members__directory-title {
    margin: 0 0 clamp(24px, 4vw, 40px);
  }

  .members__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .members__item[hidden] {
    display: none;
  }

  .members__entry summary {
    list-style: none;
  }

  .members__entry summary::-webkit-details-marker {
    display: none;
  }

  .members__row {
    align-items: baseline;
    column-gap: 24px;
    cursor: pointer;
    display: grid;
    grid-template-areas:
      'number name'
      'number email';
    grid-template-columns: 2.5rem minmax(0, 1fr);
    min-height: 44px;
    padding: 10px 0;
  }

  .members__number {
    color: var(--muted-text);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    grid-area: number;
  }

  .members__name {
    font-size: var(--text-body);
    grid-area: name;
    line-height: 1.3;
  }

  .members__email {
    color: var(--muted-text);
    font-size: var(--text-small);
    grid-area: email;
    justify-self: start;
    overflow-wrap: anywhere;
  }

  .members__row:hover .members__name {
    text-decoration: underline;
  }

  .members__bio {
    color: var(--muted-text);
    margin: 0 0 24px calc(2.5rem + 24px);
  }

  .members__bio :global(.prose) {
    font-size: var(--text-note);
    line-height: 1.45;
  }

  .members__links {
    display: flex;
    gap: 8px 24px;
    margin: 8px 0 0;
  }

  .members__links a {
    color: var(--ink);
    text-underline-offset: 0.15em;
  }

  @media (min-width: 700px) {
    .members__row {
      grid-template-areas: 'number name email';
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }

    .members__email {
      justify-self: end;
    }

    .members__bio {
      max-width: var(--measure);
    }
  }
</style>
