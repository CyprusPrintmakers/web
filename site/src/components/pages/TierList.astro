---
import type { Locale } from '../../lib/i18n/locales'
import { pickRich } from '../../lib/i18n/localized'
import { t } from '../../lib/i18n/ui'
import Prose from '../ui/Prose.astro'
import LocalizedText from '../ui/LocalizedText.astro'
import { visiblePrice, type Tier } from '../../lib/membership/tiers'

interface Props {
  tiers: Tier[]
  confirmed: boolean
  lang: Locale
}

const { tiers, confirmed, lang } = Astro.props
---

<ul class="tier-list">
  {
    tiers.map(tier => {
      const price = visiblePrice(tier, confirmed)

      return (
        <li class="tier-list__tier" data-tier>
          <div class="tier-list__head">
            <h3 class="tier-list__name t-title">
              <LocalizedText value={tier.name} lang={lang} />
            </h3>
            {price !== null && <span class="tier-list__price t-title">{price}</span>}
          </div>

          {tier.benefits && pickRich(tier.benefits, lang).length > 0 && (
            <Prose value={pickRich(tier.benefits, lang)} lang={lang} />
          )}

          {tier.levels && tier.levels.length > 0 && (
            <ul class="tier-list__levels">
              {tier.levels.map(level => {
                const levelPrice = visiblePrice(level, confirmed)
                return (
                  <li class="tier-list__level">
                    <span class="t-body">{level.name}</span>
                    {levelPrice !== null && <span class="t-body">{levelPrice}</span>}
                  </li>
                )
              })}
            </ul>
          )}
        </li>
      )
    })
  }
</ul>

{!confirmed && <p class="tier-list__gated t-small">{t('membership.gatedNotice', lang)}</p>}

<style>
  .tier-list {
    border-top: var(--rule);
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tier-list__tier {
    border-bottom: var(--rule);
    display: grid;
    gap: 16px;
    padding: 24px 0;
  }

  .tier-list__head {
    align-items: baseline;
    display: grid;
    gap: 4px 24px;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .tier-list__price {
    text-align: right;
  }

  .tier-list__name,
  .tier-list__price {
    margin: 0;
  }

  .tier-list__levels {
    display: grid;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tier-list__level {
    align-items: baseline;
    display: grid;
    gap: 4px 24px;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .tier-list__level > :last-child {
    text-align: right;
  }

  .tier-list__gated {
    color: var(--muted-text);
    margin: 16px 0 0;
  }
</style>
