---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LocalizedText from '../ui/LocalizedText.astro'
import Prose from '../ui/Prose.astro'
import Rule from '../ui/Rule.astro'
import { getContent } from '../../lib/content/source'
import type { Locale } from '../../lib/i18n/locales'
import { localePath } from '../../lib/i18n/locales'
import { pickLocalized, pickRich } from '../../lib/i18n/localized'
import { isFullyTranslated } from '../../lib/content/translation'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const { about, committee } = await getContent()
const noindex = lang === 'el' && !isFullyTranslated(about, 'aboutPage', 'el')

const body = pickRich(about.body, lang)
const history = pickRich(about.history, lang)

const headings = {
  committee: lang === 'en' ? 'Committee' : 'Επιτροπή',
  partners: lang === 'en' ? 'Partners' : 'Συνεργάτες',
}
---

<BaseLayout
  lang={lang}
  noindex={noindex}
  title={about.seo.title ?? pickLocalized(about.headline, lang).text}
  description={about.seo.description ?? ''}
  alternates={{ en: '/about', el: '/el/about' }}
>
  <article class="about">
    <h1 class="about__headline t-display" data-reveal>
      <LocalizedText value={about.headline} lang={lang} />
    </h1>

    <div class="about__intro" data-reveal style="--reveal-delay: 60ms">
      <Prose value={body} lang={lang} />
    </div>

    <figure class="about__photo" data-about-photo>
      <img
        src="/images/about-workshop.jpg"
        alt="The printmaking workshop in Pallouriotissa, Nicosia: a press and work tables."
        width="1600"
        height="1074"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="about__history" data-reveal>
      <Prose value={history} lang={lang} />
    </div>

    <Rule />

    <section class="about__section" aria-labelledby="committee-heading" data-reveal>
      <h2 id="committee-heading" class="t-title">{headings.committee}</h2>
      <ul class="about__committee">
        {
          committee.map(person => {
            const href = person.memberRef
              ? localePath(`/members/${person.memberRef}`, lang)
              : undefined

            return (
              <li class="about__committee-member">
                {href ? (
                  <a href={href}>
                    <LocalizedText value={person.name} lang={lang} />
                  </a>
                ) : (
                  <LocalizedText value={person.name} lang={lang} />
                )}
                <span class="about__committee-role">
                  <LocalizedText value={person.role} lang={lang} />
                </span>
              </li>
            )
          })
        }
      </ul>
    </section>

    <Rule />

    <section class="about__section" aria-labelledby="partners-heading" data-reveal>
      <h2 id="partners-heading" class="t-title">{headings.partners}</h2>
      <ul class="about__partners">
        {
          about.partners.map(partner => (
            <li>
              {partner.url ? (
                <a href={partner.url} rel="noopener">
                  {partner.name}
                </a>
              ) : (
                partner.name
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  .about__headline {
    margin-bottom: clamp(32px, 5vw, 80px);
  }

  .about__intro {
    margin-bottom: clamp(32px, 5vw, 80px);
  }

  .about__photo {
    margin: 0 0 clamp(48px, 6vw, 96px) auto;
    transition: transform var(--motion-settle) var(--ease-out-expo);
    width: min(100%, 560px);
    will-change: transform;
  }

  .about__photo[data-state='pending'] {
    transform: translateX(clamp(48px, 12vw, 240px));
  }

  .about__photo img {
    height: auto;
    width: 100%;
  }

  .about__history {
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .about__section {
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .about__section h2 {
    margin-bottom: clamp(16px, 2vw, 32px);
  }

  .about__committee,
  .about__partners {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about__committee-member {
    align-items: baseline;
    display: grid;
    font-size: var(--text-body);
    gap: 4px 16px;
    grid-template-columns: minmax(0, 1fr) auto;
    line-height: 1.35;
  }

  .about__committee-role {
    color: var(--muted-text);
    font-size: var(--text-note);
    text-align: right;
  }
</style>
