---
import type { Locale } from '../../lib/i18n/locales'
import { t } from '../../lib/i18n/ui'
import HeroBrand from '../layout/HeroBrand.astro'

interface Props {
  lang: Locale
  title: string
  body: string
}

const { lang, title, body } = Astro.props
---

<div class="intro" data-home-intro>
  <button class="intro__enter" type="button" aria-label={t('home.enter', lang)}>
    <span class="intro__stage" data-hero-overlay>
      <HeroBrand as="div" title={title} lang={lang} />
      <img
        class="intro__ghost"
        data-intro-ghost
        src="/mark.png"
        alt=""
        width="158"
        height="152"
        decoding="async"
      />
      {
        body && (
          <p class="intro__body" data-hero-intro-body aria-hidden="true">
            {body}
          </p>
        )
      }
    </span>
  </button>
</div>

<script is:inline src="/scripts/intro.js" defer></script>

<style is:global>
  .intro {
    background: var(--paper);
    display: none;
    inset: 0;
    overflow: hidden;
    position: fixed;
    z-index: 20;
  }

  html[data-intro='pending'] .intro,
  html[data-intro='moving'] .intro,
  html[data-intro='handoff'] .intro,
  html[data-intro='revealing'] .intro {
    display: block;
  }

  html[data-intro='revealing'] .intro {
    pointer-events: none;
  }

  .intro__enter {
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: block;
    height: 100%;
    padding: 0;
    width: 100%;
  }

  .intro__stage {
    left: 0;
    opacity: 1;
    position: fixed;
    top: 0;
    transform-origin: top left;
    will-change: transform, opacity;
  }

  /* The floating cover shows only the logo mark until the visitor enters. */
  html[data-intro='pending'] .intro__stage {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  html[data-intro='pending'] .intro .hero-brand__lead,
  html[data-intro='pending'] .intro .hero-brand__tail,
  html[data-intro='pending'] .intro__ghost,
  html[data-intro='pending'] .intro__body {
    visibility: hidden;
  }

  html[data-intro='pending'] .intro .hero-brand__mark {
    animation: intro-float 3s ease-in-out infinite;
  }

  .intro__ghost {
    left: 0;
    opacity: 0;
    position: absolute;
    top: 0;
    will-change: transform, opacity;
  }

  .intro__body {
    color: var(--graphite);
    font-size: var(--text-body);
    left: 0;
    line-height: 1.5;
    margin: 0;
    max-width: min(30em, calc(100vw - var(--pad-sm) * 2));
    position: absolute;
    text-align: left;
    top: calc(100% + clamp(16px, 3vw, 24px));
    width: max-content;
  }

  @media (min-width: 900px) {
    .intro__body {
      left: var(--intro-body-x, 50%);
      max-width: min(480px, var(--intro-body-width, calc(44vw - 48px)));
      top: var(--intro-body-y, 100%);
    }
  }

  @keyframes intro-float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none !important;
    }

    html[data-intro='pending'] .intro .hero-brand__mark {
      animation: none;
    }
  }
</style>
