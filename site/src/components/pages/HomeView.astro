---
import BaseLayout from '../../layouts/BaseLayout.astro'
import HomeIntro from './HomeIntro.astro'
import HeroBrand from '../layout/HeroBrand.astro'
import { getContent } from '../../lib/content/source'
import type { Locale } from '../../lib/i18n/locales'
import { localePath } from '../../lib/i18n/locales'
import { pickLocalized } from '../../lib/i18n/localized'
import { t } from '../../lib/i18n/ui'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const { home, projects, news, settings } = await getContent()

const title = pickLocalized(home.title, lang)
// Site settings can switch the effect off without a code change.
const inkEnabled = settings.inkEffect !== false
const heroBody = pickLocalized(home.heroBody, lang).text

const projectDate = (project: (typeof projects)[number]) =>
  project.dates?.start ?? String(project.year)
const featuredProject = [...projects]
  .filter(project => project.featured)
  .sort((a, b) => projectDate(b).localeCompare(projectDate(a)))[0]
const featuredNews = [...news]
  .filter(post => post.featured)
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))[0]

const currentLabel = `${t('current', lang)}:`
const currentTitle = featuredProject
  ? pickLocalized(featuredProject.title, lang).text
  : pickLocalized(home.currentTitle, lang).text
const currentText = `${currentLabel} ${currentTitle} →`
const currentHref = featuredProject
  ? localePath(`/projects/${featuredProject.slug}`, lang)
  : home.currentHref?.trim()
    ? localePath(home.currentHref, lang)
    : undefined

const newsText = featuredNews
  ? `${t('home.newsLabel', lang)}: ${pickLocalized(featuredNews.title, lang).text} →`
  : ''
const newsHref = featuredNews ? localePath(`/news/${featuredNews.slug}`, lang) : undefined
---

<BaseLayout
  lang={lang}
  title={home.seo.title ?? title.text}
  description={home.seo.description ?? ''}
  alternates={{ en: '/', el: '/el' }}
  homeHero={true}
>
  <section class="home-hero">
    <div class="home-hero__center">
      <div class="home-hero__brand" data-ink-hero>
        <HeroBrand as="h1" title={title.text} lang={lang} fallback={title.isFallback} />
        {
          inkEnabled && (
            <canvas class="ink-hero__canvas" data-ink-canvas aria-hidden="true" />
          )
        }
      </div>
    </div>

    {
      inkEnabled && (
        <div class="ink-roller" data-ink-roller aria-hidden="true">
          <svg viewBox="0 0 44 44" fill="none">
            <rect class="ink-roller__grip" x="14" y="2" width="16" height="8" rx="4" />
            <rect class="ink-roller__stem" x="20.8" y="10" width="2.4" height="15" rx="1.2" />
            <rect class="ink-roller__barrel" x="5" y="24" width="34" height="9" rx="4.5" />
            <rect class="ink-roller__shine" x="8" y="26.2" width="28" height="1.8" rx=".9" />
            <ellipse class="ink-roller__smudge" cx="22" cy="35.6" rx="15" ry="1.8" />
          </svg>
        </div>
      )
    }

    <div class="home-cover__links">
      <p class="home-cover__current">
        {
          currentHref ? (
            <a href={currentHref}>{currentText}</a>
          ) : (
            <span>{currentText}</span>
          )
        }
      </p>
      {
        newsHref && (
          <p class="home-cover__news">
            <a href={newsHref}>{newsText}</a>
          </p>
        )
      }
    </div>
  </section>

  <HomeIntro slot="overlay" lang={lang} title={title.text} body={heroBody} />
</BaseLayout>

<script is:inline src="/scripts/home-hero.js" defer></script>

<style>
  /*
   * The mockup canvas is one viewport with the CURRENT line on the bottom
   * edge. The frame's main area already flexes to the viewport, so the home
   * grid row stretches to fill it and the line is pushed to its bottom.
   */
  .home-hero {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .home-hero__center {
    display: grid;
    flex: 1;
    place-items: center;
  }

  .home-hero__brand {
    display: inline-block;
    position: relative;
  }

  .ink-hero__canvas {
    cursor: crosshair;
    height: 160%;
    left: -10%;
    opacity: 0;
    pointer-events: auto;
    position: absolute;
    top: -30%;
    touch-action: pan-y;
    width: 120%;
    z-index: 2;
  }

  :global(html[data-theme='dark']) .ink-hero__canvas {
    filter: invert(1);
  }

  /* Desktop cursor: the native pointer is hidden only once the roller is
     ready, so a failed script still leaves a usable crosshair. */
  .ink-roller {
    color: var(--ink);
    display: none;
    height: 44px;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: fixed;
    top: 0;
    transition: opacity 120ms var(--ease-out-expo);
    width: 44px;
    will-change: transform;
    z-index: 40;
  }

  .ink-roller svg {
    display: block;
    height: 44px;
    transform: translate(-22px, -33px);
    transition: transform 90ms var(--ease-out-expo);
    width: 44px;
    will-change: transform;
  }

  .ink-roller__grip,
  .ink-roller__stem,
  .ink-roller__barrel {
    fill: currentColor;
  }

  .ink-roller__shine {
    fill: var(--paper);
    opacity: 0.6;
  }

  .ink-roller__smudge {
    fill: currentColor;
    opacity: 0.12;
  }

  .ink-roller[data-visible='1'] {
    opacity: 1;
  }

  .ink-roller[data-pressing='1'] svg {
    transform: translate(-22px, -30px) scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .ink-roller {
      display: block;
    }

    .ink-hero__canvas[data-ink-custom-cursor='1'] {
      cursor: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-hero__canvas {
      display: none;
    }

    .ink-roller,
    .ink-roller svg {
      transition: none;
    }
  }

  .home-cover__links {
    display: grid;
    gap: 8px;
    margin-top: auto;
    padding-bottom: 16px;
    padding-top: clamp(24px, 4vw, 64px);
  }

  .home-cover__current,
  .home-cover__news {
    color: var(--graphite);
    font-size: 24px;
    line-height: 1.4;
    margin: 0;
  }

  .home-cover__current a,
  .home-cover__news a {
    color: inherit;
    text-decoration: none;
  }

  .home-cover__current a:hover,
  .home-cover__news a:hover {
    text-decoration: underline;
  }

  @media (max-width: 899px) {
    .home-cover__links {
      padding-top: 24px;
    }

    .home-cover__current,
    .home-cover__news {
      font-size: var(--text-note);
      line-height: 1.35;
    }
  }
</style>

<style is:global>
  /* Home: flex growth, not percentage heights, stretches the hero to the
     viewport so short or zoomed viewports can grow past it without overlap. */
  main:has(.home-hero) {
    display: flex;
    flex-direction: column;
    /* Clip the ink at the viewport edge, not at the shell's content edge, so
       the effect doesn't end in a visible rectangle around the title. */
    overflow-x: clip;
  }

  main:has(.home-hero) .grid-12 {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  html:has(.home-hero) .page footer {
    margin-top: 0;
  }
</style>
