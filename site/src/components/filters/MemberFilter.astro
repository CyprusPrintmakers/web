---
import type { Locale } from '../../lib/i18n/locales'
import { t } from '../../lib/i18n/ui'

interface Props {
  lang: Locale
  letters: string[]
  total: number
}

const { lang, letters, total } = Astro.props
const initialCount =
  total === 1 ? t('members.countOne', lang) : t('members.countMany', lang)
---

<div class="member-filter">
  <p
    class="member-filter__count t-small"
    data-member-count
    aria-live="polite"
    data-count-one={t('members.countOne', lang)}
    data-count-many={t('members.countMany', lang)}
  >
    {initialCount.replace('{n}', String(total))}
  </p>

  <div class="member-filter__letters" role="group" aria-label={t('members.directory', lang)}>
    {
      letters.map(letter => (
        <button
          type="button"
          class="member-filter__letter t-small"
          data-letter-button
          data-letter={letter}
          aria-pressed="false"
        >
          {letter}
        </button>
      ))
    }
  </div>
</div>

<style>
  .member-filter {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin-bottom: clamp(16px, 3vw, 24px);
  }

  .member-filter__count {
    color: var(--muted-text);
    margin: 0;
  }

  .member-filter__letters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px clamp(6px, 1.4vw, 18px);
    margin-left: auto;
  }

  .member-filter__letter {
    background: transparent;
    border: 0;
    color: var(--muted-text);
    cursor: pointer;
    letter-spacing: 0.06em;
    min-height: 24px;
    min-width: 24px;
    padding: 2px;
  }

  .member-filter__letter:hover,
  .member-filter__letter[aria-pressed='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
