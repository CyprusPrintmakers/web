---
import type { Locale } from '../../lib/i18n/locales'
import { t } from '../../lib/i18n/ui'

interface Props {
  lang: Locale
  years: number[]
}

const { lang, years } = Astro.props
---

<div class="project-filter" role="group" aria-label={t('projects.years', lang)}>
  <button
    type="button"
    class="project-filter__year"
    data-year-button
    data-year=""
    aria-pressed="true"
  >
    {t('projects.allYears', lang)}
  </button>
  {
    years.map(year => (
      <button
        type="button"
        class="project-filter__year"
        data-year-button
        data-year={String(year)}
        aria-pressed="false"
      >
        {year}
      </button>
    ))
  }
</div>

<style>
  .project-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: clamp(24px, 4vw, 48px);
  }

  .project-filter__year {
    background: transparent;
    border: var(--rule);
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-size: 20px;
    min-height: 44px;
    padding: 0 20px;
  }

  .project-filter__year[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>
