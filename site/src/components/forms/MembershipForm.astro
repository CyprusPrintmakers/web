---
import type { Locale } from '../../lib/i18n/locales'
import { localePath } from '../../lib/i18n/locales'
import { t } from '../../lib/i18n/ui'
import FormStatus from './FormStatus.astro'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
---

<form
  class="form"
  method="post"
  action="/api/membership"
  enctype="multipart/form-data"
  data-form
>
  <input type="hidden" name="locale" value={lang} />
  <input type="hidden" name="renderedAt" value="" data-rendered-at />

  <div aria-hidden="true" class="form__honeypot">
    <label for="membership-website">Website</label>
    <input id="membership-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form__row">
    <div class="form__field">
      <label class="form__label t-label" for="membership-name">
        {t('form.fullName', lang)} <span aria-hidden="true">*</span>
      </label>
      <input
        class="form__input"
        id="membership-name"
        name="name"
        type="text"
        required
        autocomplete="name"
      />
      <p class="form__error t-small" data-error="name"></p>
    </div>

    <p class="form__required-note t-small">{t('form.requiredNote', lang)}</p>
  </div>

  <div class="form__field">
    <label class="form__label t-label" for="membership-email">
      {t('form.email', lang)} <span aria-hidden="true">*</span>
    </label>
    <input
      class="form__input"
      id="membership-email"
      name="email"
      type="email"
      required
      autocomplete="email"
    />
    <p class="form__error t-small" data-error="email"></p>
  </div>

  <div class="form__field">
    <label class="form__label t-label" for="membership-phone">
      {t('form.mobile', lang)}
    </label>
    <input
      class="form__input"
      id="membership-phone"
      name="phone"
      type="tel"
      autocomplete="tel"
    />
    <p class="form__error t-small" data-error="phone"></p>
  </div>

  <div class="form__field">
    <label class="form__label t-label" for="membership-message">
      {t('form.why', lang)} <span aria-hidden="true">*</span>
    </label>
    <textarea class="form__input" id="membership-message" name="message" rows="4" required></textarea>
    <p class="form__error t-small" data-error="message"></p>
  </div>

  <div class="form__field form__field--cv">
    <input
      class="form__file"
      id="membership-cv"
      name="cv"
      type="file"
      accept=".pdf,.doc,.docx"
      required
    />
    <label class="form__label form__label--action t-label" for="membership-cv">
      {t('form.cvAction', lang)} <span aria-hidden="true">* →</span>
    </label>
    <p class="form__note t-small">{t('form.cvNote', lang)}</p>
    <p class="form__error t-small" data-error="cv"></p>
  </div>

  <div class="form__field form__field--consent">
    <input class="form__checkbox" id="membership-consent" name="consent" type="checkbox" required />
    <label class="form__label t-small" for="membership-consent">
      <a href={localePath('/privacy', lang)}>{t('form.consent', lang)}</a>
    </label>
    <p class="form__error t-small" data-error="consent"></p>
  </div>

  <FormStatus />

  <button class="form__submit" type="submit">{t('form.submit', lang)}</button>
</form>

<script is:inline src="/scripts/forms.js" defer></script>

<style>
  .form {
    display: grid;
    gap: 28px;
  }

  .form__honeypot {
    left: -9999px;
    position: absolute;
  }

  .form__row {
    display: grid;
    gap: 8px 32px;
    grid-template-columns: minmax(0, 1fr);
  }

  .form__field {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .form__field--consent {
    align-items: start;
    grid-template-columns: auto 1fr;
  }

  .form__label {
    color: var(--ink);
  }

  .form__required-note {
    color: var(--muted-text);
    margin: 0;
  }

  .form__input {
    background: transparent;
    border: 0;
    border-bottom: var(--rule);
    border-radius: 0;
    color: var(--ink);
    font-size: var(--text-body);
    min-height: 48px;
    min-width: 0;
    padding: 8px 0;
    width: 100%;
  }

  textarea.form__input {
    resize: vertical;
  }

  .form__file {
    height: 1px;
    opacity: 0;
    position: absolute;
    width: 1px;
  }

  .form__label--action {
    color: var(--ink);
    cursor: pointer;
    justify-self: start;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .form__file:focus-visible + .form__label--action {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .form__checkbox {
    height: 24px;
    margin-top: 2px;
    width: 24px;
  }

  .form__error {
    color: var(--muted-text);
    margin: 0;
    min-height: 1em;
  }

  .form__error:not(:empty) {
    color: var(--graphite);
    text-decoration: underline;
  }

  .form__note {
    color: var(--muted-text);
    margin: 0;
  }

  .form__submit {
    background: var(--control);
    border: 0;
    border-radius: var(--radius-pill);
    color: var(--ink);
    cursor: pointer;
    font-size: var(--text-body);
    font-weight: var(--fw-medium);
    justify-self: start;
    min-height: 48px;
    min-width: 180px;
    padding: 0 32px;
  }

  .form__submit:hover {
    background: var(--ink);
    color: var(--paper);
  }

  @media (min-width: 700px) {
    .form__row {
      align-items: end;
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .form__required-note {
      padding-bottom: 10px;
    }
  }
</style>
