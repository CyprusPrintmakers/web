---
import type { Locale } from '../../lib/i18n/locales'
import { t } from '../../lib/i18n/ui'
import FormStatus from './FormStatus.astro'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
---

<form
  class="form"
  method="post"
  action="/api/contact"
  enctype="multipart/form-data"
  data-form
>
  <input type="hidden" name="locale" value={lang} />
  <input type="hidden" name="renderedAt" value="" data-rendered-at />

  <div aria-hidden="true" class="form__honeypot">
    <label for="contact-website">Website</label>
    <input id="contact-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form__field">
    <label class="form__label t-small" for="contact-name">{t('form.name', lang)}</label>
    <input
      class="form__input"
      id="contact-name"
      name="name"
      type="text"
      required
      autocomplete="name"
    />
    <p class="form__error t-small" data-error="name"></p>
  </div>

  <div class="form__field">
    <label class="form__label t-small" for="contact-email">{t('form.email', lang)}</label>
    <input
      class="form__input"
      id="contact-email"
      name="email"
      type="email"
      required
      autocomplete="email"
    />
    <p class="form__error t-small" data-error="email"></p>
  </div>

  <div class="form__field">
    <label class="form__label t-small" for="contact-phone">{t('form.phone', lang)}</label>
    <input class="form__input" id="contact-phone" name="phone" type="tel" autocomplete="tel" />
    <p class="form__error t-small" data-error="phone"></p>
  </div>

  <div class="form__field">
    <label class="form__label t-small" for="contact-message">{t('form.message', lang)}</label>
    <textarea class="form__input" id="contact-message" name="message" rows="5" required></textarea>
    <p class="form__error t-small" data-error="message"></p>
  </div>

  <FormStatus />

  <button class="form__submit" type="submit">{t('form.sendMessage', lang)}</button>
</form>

<script is:inline src="/scripts/forms.js" defer></script>

<style>
  .form {
    display: grid;
    gap: 24px;
    max-width: 40em;
  }

  .form__honeypot {
    left: -9999px;
    position: absolute;
  }

  .form__field {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .form__label {
    color: var(--muted-text);
  }

  .form__input {
    background: transparent;
    border: 0;
    border-bottom: var(--rule);
    font-size: 20px;
    min-width: 0;
    padding: 8px 2px;
    width: 100%;
  }

  textarea.form__input {
    border: var(--rule);
    padding: 8px;
  }

  .form__error {
    color: var(--muted-text);
    margin: 0;
    min-height: 1em;
  }

  .form__error:not(:empty) {
    color: var(--graphite);
    text-decoration: underline;
  }

  .form__submit {
    background: transparent;
    border: var(--rule);
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-size: 20px;
    justify-self: start;
    min-height: 44px;
    padding: 0 32px;
  }

  .form__submit:hover {
    background: var(--ink);
    color: var(--paper);
  }
</style>
