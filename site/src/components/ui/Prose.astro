---
import type { Locale } from '../../lib/i18n/locales'
import type { ImageDoc } from '../../lib/media'
import {
  portableToHtml,
  type PortableTextImage,
  type PortableTextValue,
} from '../../lib/content/portable'
import { sanityImageUrl } from '../../lib/sanity/image'

interface Props {
  value: PortableTextValue[]
  lang: Locale
  imageUrl?: (image: PortableTextImage) => string | undefined
}

const {
  value,
  lang,
  imageUrl = (image: PortableTextImage) => sanityImageUrl(image as ImageDoc),
} = Astro.props
const html = portableToHtml(value, { lang, imageUrl })
---

{html && <div class="prose" set:html={html}></div>}

<style>
  .prose {
    font-size: 24px;
    line-height: 1.4;
  }

  .prose :global(p) {
    margin: 0 0 24px;
  }

  .prose :global(h2) {
    font-size: 36px;
    line-height: 1.1;
    margin: 48px 0 16px;
  }

  .prose :global(h3) {
    font-size: 32px;
    line-height: 1.15;
    margin: 32px 0 16px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 24px;
    padding-left: 1.5em;
  }

  .prose :global(blockquote) {
    border-left: var(--rule);
    margin: 0 0 24px;
    padding-left: 24px;
  }

  .prose :global(a) {
    text-decoration: underline;
  }

  .prose :global(figure) {
    margin: 0 0 24px;
  }

  .prose :global(img) {
    border: var(--rule);
    height: auto;
    width: 100%;
  }
</style>
