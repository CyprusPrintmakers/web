---
import NewsPostView from '../../../components/pages/NewsPostView.astro'
import { getContent } from '../../../lib/content/source'
import { getLocaleSlugParams, type Locale } from '../../../lib/i18n/locales'

export async function getStaticPaths() {
  const { news } = await getContent()
  return getLocaleSlugParams(news.map(post => post.slug)).map(entry => ({
    params: entry.params,
    props: { post: news.find(candidate => candidate.slug === entry.params.slug)! },
  }))
}

const { post } = Astro.props
const lang = Astro.params.lang as Locale
---

<NewsPostView lang={lang} post={post} />
