{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cyprintmakers.com"
        }
      ],
      "destination": "https://www.cyprintmakers.com/:path*",
      "permanent": true
    },
    {
      "source": "/members/:slug",
      "destination": "/members",
      "permanent": true
    },
    {
      "source": "/el/members/:slug",
      "destination": "/el/members",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/membership",
      "permanent": true
    },
    {
      "source": "/el/support",
      "destination": "/el/membership",
      "permanent": true
    }
  ]
}
