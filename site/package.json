{
  "name": "cyprus-printmakers-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:studio && astro build",
    "build:fixtures": "CONTENT_SOURCE=fixtures astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "manifest": "sanity manifest extract --path public/static",
    "import:projects": "tsx scripts/import-projects.ts --dry-run",
    "import:members": "tsx scripts/import-members.ts --dry-run",
    "import:content": "tsx scripts/import-content.ts",
    "import:content:dry": "tsx scripts/import-content.ts --dry-run",
    "import:pages": "tsx scripts/import-pages.ts",
    "import:pages:dry": "tsx scripts/import-pages.ts --dry-run",
    "predev": "rm -rf public/admin",
    "build:studio": "node scripts/build-studio.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@portabletext/to-html": "^6.0.0",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "^3.6.0",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "sanity": "^6.20.0",
    "sanity-plugin-internationalized-array": "^5.3.7",
    "styled-components": "^6.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "entities": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
